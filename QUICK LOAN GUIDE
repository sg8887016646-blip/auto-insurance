<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Quick Loan Guide - Loan Information</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f7fb;
    color: #222;
}

header {
    background: #071d35;
    color: white;
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 24px;
    font-weight: bold;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 18px;
}

.hero {
    background: linear-gradient(120deg, #071d35, #0879c9);
    color: white;
    padding: 100px 8%;
    text-align: center;
}

.hero h1 {
    font-size: 42px;
    margin-bottom: 20px;
}

.hero p {
    font-size: 18px;
    line-height: 1.6;
    margin-bottom: 30px;
}

.btn {
    display: inline-block;
    background: #ffb703;
    color: #071d35;
    padding: 15px 30px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: bold;
    cursor: pointer;
}

.btn:hover {
    background: white;
}

section {
    padding: 65px 8%;
    text-align: center;
}

h2 {
    font-size: 30px;
    margin-bottom: 30px;
    color: #071d35;
}

.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.card {
    background: white;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 3px 15px #00000012;
}

.card h3 {
    color: #0879c9;
    margin-bottom: 15px;
}

.card p {
    line-height: 1.7;
}

.about {
    background: #e8f1fa;
}

.offer {
    background: white;
}

.offer p {
    line-height: 1.7;
    margin-bottom: 25px;
}

.disclaimer {
    font-size: 13px;
    color: #666;
    margin-top: 25px;
}

footer {
    background: #071d35;
    color: white;
    text-align: center;
    padding: 30px;
}

footer p {
    margin-top: 10px;
}

@media(max-width: 700px) {

    .cards {
        grid-template-columns: 1fr;
    }

    header {
        flex-direction: column;
        gap: 15px;
    }

    nav a {
        margin: 5px;
        display: inline-block;
    }

    .hero h1 {
        font-size: 30px;
    }
}
</style>
</head>

